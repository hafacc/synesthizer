{
  "name": "synesthizer",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean-audio": "for file in public/*.aiff; do case $file in *.mf.*) out=static;; *) out=samples;; esac; ffmpeg -y -i $file -af silenceremove=start_periods=1:start_duration=0.1:start_threshold=-60dB $out/$(basename $file .aiff).mp3; done",
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "export": "vite build",
    "fmt": "biome format --write && biome check --write",
    "lint": "biome check && svelte-check && tsc -p src/service-worker --noEmit && bun test",
    "start": "vite preview"
  },
  "dependencies": {
    "@lucide/svelte": "^1.52.0",
    "core-js": "^3.49.0",
    "mode-watcher": "^1.1.0",
    "svelte-file-dropzone": "^2.0.9",
    "tone": "^15.1.22",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6",
    "vite": "^8.3.3"
  }
}
